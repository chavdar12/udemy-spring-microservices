# Line endings: LF in the repo and on checkout, so every OS gets the same files (CI and formatters expect LF).
* text=auto eol=lf

# Windows scripts need CRLF to run
*.bat text eol=crlf
*.cmd text eol=crlf

# Gradle wrapper script must stay LF to run on Linux/macOS
gradlew text eol=lf

# Binaries: never diffed or converted
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text
*.jar binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp3 binary
*.mp4 binary
*.db binary
*.sqlite binary
*.bson binary
*.xlsx binary
*.docx binary

# Lock files: generated, collapsed in diffs and left out of language stats
package-lock.json linguist-generated -diff
composer.lock linguist-generated -diff
